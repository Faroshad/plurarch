{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plurarch decision record",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "proposal", "applied_parameters", "evidence", "alternatives_considered", "changes", "rationale"],
  "properties": {
    "verdict": { "type": "string", "enum": ["ACCEPTED", "MODIFIED", "REJECTED"] },
    "proposal": {
      "description": "The participants' proposed parameters, exactly as given in the round's proposal.",
      "$ref": "#/definitions/parameters"
    },
    "applied_parameters": {
      "description": "The parameters now applied to the model. For REJECTED: the current (unchanged) parameters.",
      "$ref": "#/definitions/parameters"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_metrics", "applied_metrics", "failed_rules", "failed_goals"],
      "properties": {
        "proposal_metrics": { "$ref": "#/definitions/metrics" },
        "applied_metrics": { "$ref": "#/definitions/metrics" },
        "failed_rules": {
          "description": "Ids of the hard rules the PROPOSAL fails (from evaluate).",
          "type": "array", "items": { "type": "string" }
        },
        "failed_goals": {
          "description": "Ids of the goals the PROPOSAL fails beyond the close trade-off margin (from evaluate).",
          "type": "array", "items": { "type": "string" }
        }
      }
    },
    "alternatives_considered": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameters", "metrics", "hard_rules_pass", "note"],
        "properties": {
          "parameters": { "$ref": "#/definitions/parameters" },
          "metrics": { "$ref": "#/definitions/metrics" },
          "hard_rules_pass": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "changes": {
      "description": "Each parameter whose applied value differs from the proposal. Empty for ACCEPTED and REJECTED.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "from", "to", "reason"],
        "properties": {
          "parameter": { "type": "string" },
          "from": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
          "to": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
          "reason": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "rationale": {
      "description": "At most 3 short sentences in plain language, citing specific metric values (before vs after).",
      "type": "string", "minLength": 20, "maxLength": 600
    },
    "consistency_note": {
      "description": "How this decision relates to earlier decisions in the session; required when it departs from one.",
      "type": "string", "maxLength": 300
    },
    "what_to_vote_for": {
      "description": "REJECTED only: a concrete valid alternative participants could vote for next round.",
      "type": "string", "maxLength": 300
    }
  },
  "definitions": {
    "parameters": {
      "type": "object",
      "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    }
  }
}
