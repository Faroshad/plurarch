# Copy to .env (git-ignored) and fill in. Only needed for Supabase mode.
# Supabase dashboard > Project Settings > API Keys (see supabase/SETUP.md).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public by design (also goes into site/config.js): the anon / publishable key.
SUPABASE_ANON_KEY=
# SECRET: the service_role / secret key. Full access, bypasses RLS. Only the orchestrator on the
# facilitator's laptop uses it. Never put it in site/ or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, for tests/test_rls.py:
#   a signed-in account that is NOT a facilitator (must not see votes)
TEST_NON_FACILITATOR_EMAIL=
TEST_NON_FACILITATOR_PASSWORD=
#   the facilitator account (must see votes)
TEST_FACILITATOR_EMAIL=
TEST_FACILITATOR_PASSWORD=
